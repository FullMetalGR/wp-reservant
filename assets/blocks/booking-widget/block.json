{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reservant/booking-widget",
	"title": "Booking Widget",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Let visitors book appointments, chains and events.",
	"keywords": [ "booking", "appointment", "reservation", "event" ],
	"textdomain": "reservant",
	"attributes": {
		"serviceId": { "type": "number", "default": 0 },
		"resourceId": { "type": "number", "default": 0 },
		"accent": { "type": "string", "default": "" },
		"radius": { "type": "number", "default": 6 },
		"density": {
			"type": "string",
			"enum": [ "comfortable", "compact" ],
			"default": "comfortable"
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"editorScript": "reservant-widget-editor",
	"editorStyle": "reservant-widget-editor"
}
