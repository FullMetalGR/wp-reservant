{
  "name": "ads-solutions/reservant",
  "description": "Bookings for appointments, chains, and events - with or without WooCommerce.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^3.8"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/woocommerce-stubs": "^11.0",
    "php-stubs/wordpress-stubs": "^6.6",
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^9.6.22",
    "squizlabs/php_codesniffer": "^3.13.6",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": { "psr-4": { "Reservant\\": "src/" } },
  "autoload-dev": { "psr-4": { "Reservant\\Tests\\": "tests/" } },
  "scripts": {
    "test:unit": "phpunit -c phpunit-unit.xml.dist",
    "test:integration": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/reservant vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "lint": "phpcs -q",
    "stan": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true,
    "platform": { "php": "8.1.0" },
    "process-timeout": 900
  }
}
